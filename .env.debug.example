# 선택: 이 파일을 복사해 `.env.debug`로 저장한다. Git에 올리지 않는다.
# `config/settings.py`가 `.env` 다음에 `.env.debug`를 로드한다(있을 때만).
# Windows: copy .env.debug.example .env.debug
#
# 정의·기본값·분류: documents/ai/manuals/environment.md
# 런타임 플래그 구현: config/shapez_runtime_flags.py

# copy 디버그 JSON 덤프. 상대 경로는 프로젝트 루트 기준. 비우면 OFF.
# SHAPEZ_COPY_DEBUG_DIR=var/shapez_copy_debug

# Asteroid Lab 경계 JSONL (stdout/stderr 아님). 1=on
# ASTEROID_LAB_BOUNDARY_JSONL=1
# ASTEROID_LAB_BOUNDARY_JSONL_DIR=var/asteroid_boundary_logs

# 솔버/매크로 그래프 서버 PNG 썸네일. Render 등 node 없으면 noop 권장.
# SOLVER_GRAPH_PREVIEW_RENDERER=noop
# SOLVER_GRAPH_PREVIEW_STORAGE=filesystem
# SOLVER_GRAPH_PREVIEW_CACHE_DIR=var/shapez_graph_preview_cache
