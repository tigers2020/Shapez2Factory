# 로컬용: 이 파일을 복사해 `.env`로 저장한 뒤 값을 채운다.
# Windows: copy .env.example .env
# Git에는 `.env`를 올리지 않는다(.gitignore).
#
# 관측·디버그·프리뷰 noop 등은 `.env.debug.example` → `.env.debug` (선택).
# Windows: copy .env.debug.example .env.debug
#
# Render 등 배포: 정적 파일(CSS·이미지·recipe_graph_editor 번들)은 WhiteNoise로 서빙하려면
# 빌드 단계에서 `npm run build` 후 `migrate`·`collectstatic` 필요(django_site 등).
#   bash scripts/render_build.sh
# 시작 커맨드에서 마이그레이션 유지(에페메럴 디스크): bash scripts/render_start.sh

# 배포(예: Render)에서 커스텀 도메인만 추가할 때 쉼표로 구분.
# DJANGO_ALLOWED_HOSTS=

# PostgreSQL (Render 등): Internal Database URL을 그대로 넣으면 됨. 비우면 로컬 SQLite(db.sqlite3).
# Neon 등으로 원격 DB를 쓰지 않을 때: `DATABASE_URL`을 비우거나 아래를 1로 두면
# 환경에 `DATABASE_URL`이 있어도 로컬 SQLite(db.sqlite3)만 사용한다.
# DJANGO_USE_SQLITE=1
# DATABASE_URL=

# 환경 변수 정본·분류: documents/ai/manuals/environment.md

# Asteroid Lab POST JSON / attach 관측 로그를 ``var/log/asteroid_lab.log``에 기록(기본 ON). 배포에서 파일 쓰기를 끄려면 0.
# ASTEROID_LAB_FILE_LOG=0

# --- django-allauth (Google client id·secret 쌍이 있어야 Google 로그인 URL 동작) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 생략하거나 빈 값이면 기본 https://ko-fi.com/shapez2factory/
SUPPORT_KOFI_URL=
SUPPORT_GITHUB_SPONSORS_URL=
SUPPORT_PATREON_URL=
