# 로컬용: 이 파일을 복사해 `.env`로 저장한 뒤 값을 채운다.
# Windows: copy .env.example .env
# Git에는 `.env`를 올리지 않는다(.gitignore).
#
# Render 등 배포: 정적 파일(CSS·이미지·recipe_graph_editor 번들)은 WhiteNoise로 서빙하려면
# 빌드 단계에서 `npm run build` 후 `migrate`·`collectstatic` 필요(django_site 등).
#   bash scripts/render_build.sh
# 시작 커맨드에서 마이그레이션 유지(에페메럴 디스크): bash scripts/render_start.sh
# (수동: npm ci && npm run build && poetry install && poetry run python manage.py migrate --noinput && poetry run python manage.py collectstatic --noinput)

# 배포(예: Render)에서 커스텀 도메인만 추가할 때 쉼표로 구분. Render 기본 onrender.com 호스트는
# 플랫폼이 주입하는 RENDER_EXTERNAL_HOSTNAME으로 자동 허용되므로 보통 비워 둔다.
# DJANGO_ALLOWED_HOSTS=

# --- django-allauth (Google client id·secret 쌍이 있어야 Google 로그인 URL 동작) ---
# Google 로그인 시 redirect_uri_mismatch(400)면: Cloud Console → 사용자 인증 정보
# → OAuth 2.0 클라이언트(유형: 웹 애플리케이션) → "승인된 리디렉션 URI"에
# 실제로 접속할 때 쓰는 호스트·포트와 동일한 URL을 넣는다.
#   http://127.0.0.1:8000/accounts/google/login/callback/
#   http://localhost:8000/accounts/google/login/callback/
# 위 둘은 Google에 서로 다른 URI이므로, 쓰는 쪽만 등록하거나 둘 다 등록한다.
# Social Applications의 Site는 이 오류와 무관(redirect_uri는 요청 Host 기준으로 생성됨).
# 동일 provider를 admin SocialApp과 아래 env 동시에 두지 말 것(중복 앱으로 콜백 401 등 유발).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Ko-fi 프로필 URL이면 후원 페이지에 위젯 iframe이 표시됩니다(예: https://ko-fi.com/shapez2factory/).
SUPPORT_KOFI_URL=
SUPPORT_GITHUB_SPONSORS_URL=
SUPPORT_PATREON_URL=
