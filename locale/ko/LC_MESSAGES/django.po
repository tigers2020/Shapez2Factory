msgstr "입력 [{{ in_slots }}] -> 출력 [{{ out_slots }}]"

msgid ""
"No active DB macro matched the inventory signature. Load the seed fixture or"
" add a MacroRecipe in admin."
msgstr "인벤토리 시그니처와 맞는 활성 매크로가 DB에 없습니다. 시드 픽스처를 넣거나 관리자에서 MacroRecipe를 추가하세요."

